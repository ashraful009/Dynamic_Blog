# ==============================================================================
# Backend REST API Environment Variables (https://api.ferdausanamjibon.com)
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=production

# MySQL 8.0+ / MariaDB 10.6+ Database Connection URL
# Format: mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>?charset=utf8mb4
DATABASE_URL=mysql://zibon_user:STRONG_DB_PASSWORD@127.0.0.1:3306/zibon_blog

# Cryptographically Secure JWT Secret (generate with: openssl rand -base64 48)
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=1d

# Allowed Cross-Origin Resource Sharing (CORS) & CSRF defense origins
# Comma-separated domains for public website (with & without www)
PUBLIC_FRONTEND_URL=https://ferdausanamjibon.com,https://www.ferdausanamjibon.com

# Admin CMS Origin (for secure cookie exchange & RBAC access)
ADMIN_FRONTEND_URL=https://cms.ferdausanamjibon.com

# Cloudinary Storage Credentials for Media Uploads
CLOUDINARY_CLOUD_NAME=dorpqzfj7
CLOUDINARY_API_KEY=654172774656669
CLOUDINARY_API_SECRET=ksNS3-oTqk8ogcnk-MU88oo278I

# Initial Admin Seeding Credentials (for npx ts-node prisma/seed.ts)
ADMIN_EMAIL=zibon@gmail.com
ADMIN_PASSWORD=STRONG_ADMIN_PASSWORD_HERE
